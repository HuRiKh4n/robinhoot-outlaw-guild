# Disabled by default. Do not enable until migration, real wallet flow and isolation tests pass.
GUILD_IDENTITY_ENABLED=false
# Exact stable HTTPS preview origin; no path, trailing slash, wildcard or forwarded-host derivation.
GUILD_AUTH_ORIGIN=https://your-preview-domain.example
# Managed PostgreSQL connection with validated TLS. Never expose as NEXT_PUBLIC_*.
DATABASE_URL=
# Optional trusted private CA PEM supplied by your database provider.
GUILD_DATABASE_CA=
# Trusted mainnet RPC query endpoint. HTTPS only; private credentials may be in this server-only URL.
NEAR_MAINNET_RPC_URL=
