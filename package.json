{
  "name": "robinhoot-outlaw-guild",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "validate:art": "node scripts/validate-character-assets.mjs",
    "register:art": "node scripts/register-character-art.mjs",
    "test:assets": "node --test scripts/validate-character-assets.test.mjs",
    "prebuild": "npm run validate:art",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:security": "node --conditions=react-server --import tsx --test tests/security/*.test.ts"
  },
  "dependencies": {
    "@meteorwallet/sdk": "3.24.0",
    "@near-js/keystores": "2.2.5",
    "bs58": "6.0.0",
    "next": "^15.5.0",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@near-js/crypto": "2.5.1",
    "@near-js/signers": "2.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    },
    "@meteorwallet/sdk": {
      "nanoid": "5.1.16"
    }
  }
}
